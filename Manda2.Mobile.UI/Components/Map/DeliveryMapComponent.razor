@inject IJSRuntime JS
@implements IAsyncDisposable

<div style="width:100%; height:300px; border:1px solid #ccc; border-radius:12px;">
    <div id="@MapId" style="width:100%; height:100%;"></div>
</div>

@code {
    [Parameter] public string MapId { get; set; } = "delivery-map";
    [Parameter] public double Latitude { get; set; } = 14.6349;
    [Parameter] public double Longitude { get; set; } = -90.5069;

    private DotNetObjectReference<DeliveryMapComponent>? _dotNetRef;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;

        try
        {
            if (Latitude == 0 || Longitude == 0)
            {
                Latitude = 14.6349;
                Longitude = -90.5069;
            }

            _dotNetRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "DeliveryMap.init",
                MapId,
                Latitude,
                Longitude,
                "7PZOy9bQitGrSPIX1f0IKmXSIIeny2zO8n6r70dz3TJ2dTcJVyKaJQQJ99CFACrJL3JAmTUoAAAgAZMP1VZk",
                _dotNetRef
            );

            _initialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DeliveryMapComponent] Error: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnMapMoved(double lat, double lon)
    {
        try
        {
            Console.WriteLine($"[DeliveryMapComponent] Pin movido a: {lat}, {lon}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DeliveryMapComponent] Error en OnMapMoved: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("DeliveryMap.destroy", MapId);
            _dotNetRef?.Dispose();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DeliveryMapComponent] Dispose error: {ex.Message}");
        }
    }
}