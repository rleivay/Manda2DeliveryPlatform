@using Manda2.Contracts.Catalog
@inject HttpClient HttpClient

<div class="card merchant-card border-0 shadow-sm h-100 mb-2"
     @onclick="OnClick"
     style="cursor: pointer;">

    <div class="position-relative">
        <img src="@(_logoBase64 ?? "https://placehold.co/400x200?text=Comercio")"
             class="card-img-top merchant-img"
             alt="@Merchant.Name" />

        @if (Merchant.IsOpen)
        {
            <div class="badge bg-success position-absolute top-0 end-0 m-2 shadow">
                Abierto
            </div>
        }
        else
        {
            <div class="badge bg-secondary position-absolute top-0 end-0 m-2 shadow">
                Cerrado
            </div>
        }

    </div>

    <div class="card-body p-3">

        <div class="d-flex justify-content-between align-items-start mb-1">
            <h5 class="card-title fw-bold m-0 text-truncate" style="max-width: 80%;">
                @Merchant.Name
            </h5>
            <div class="d-flex align-items-center">
                <i class="bi bi-star-fill text-warning me-1 small"></i>
                <span class="small fw-bold">4.5</span> @* Estático — rating no viene en DTO aún *@
            </div>
        </div>

        <p class="card-text text-muted small mb-2 text-truncate">
            @Merchant.CategoryName
        </p>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="d-flex align-items-center text-muted small">
                <i class="bi bi-clock me-1"></i>
                <span>25-35 min</span> @* Estático — tiempo estimado pendiente de DTO *@
            </div>
            <div class="d-flex align-items-center text-success small fw-bold">
                <i class="bi bi-bicycle me-1"></i>
                <span>Envío Gratis</span> @* Estático — fee pendiente de DTO *@
            </div>
        </div>

    </div>
</div>



@code {
    // ── Parámetros ──────────────────────────────────────────────────────────

    /// <summary>
    /// DTO del comercio a renderizar. Obligatorio.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public MerchantSummaryDto Merchant { get; set; } = null!;

    /// <summary>
    /// Callback que se dispara al hacer click en la tarjeta.
    /// El padre (CustomerHome) navega al detalle del comercio.
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    // ── Estado interno ───────────────────────────────────────────────────────

    /// <summary>
    /// Logo del comercio codificado en base64.
    /// Null mientras carga o si no hay LogoUrl — muestra placeholder.
    /// </summary>
    private string? _logoBase64;

    // ── Ciclo de vida ────────────────────────────────────────────────────────

    /// <summary>
    /// Al inicializar el componente, descarga el logo del comercio
    /// y lo convierte a base64 para evitar bloqueos del WebView2
    /// con certificados self-signed en desarrollo.
    /// </summary>

    private int _lastLoadedMerchantId = -1; // ← control de cambio
    
    protected override async Task OnParametersSetAsync()
    {
        // Solo recarga si cambió el comercio
        if (Merchant.MerchantId != _lastLoadedMerchantId)
        {
            _lastLoadedMerchantId = Merchant.MerchantId;
            _logoBase64 = null; // Limpiar imagen anterior
            await LoadLogoAsync();
        }
    }

    private async Task LoadLogoAsync()
    {
        if (string.IsNullOrEmpty(Merchant.LogoUrl)) return;

        try
        {
            var handler = new HttpClientHandler
            {
                ServerCertificateCustomValidationCallback =
                    HttpClientHandler.DangerousAcceptAnyServerCertificateValidator
            };
            using var client = new HttpClient(handler);
            var bytes = await client.GetByteArrayAsync(Merchant.LogoUrl);
            _logoBase64 = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            _logoBase64 = null;
        }
    }
}